{
  "name": "espin",
  "title": "E-SPIN Platform",
  "description": "Custom Platform for E-SPIN Board (Wrapper around espressif32)",
  "version": "1.0.0",
  "homepage": "https://github.com/urbskali/e_spin-board",
  "license": "MIT",
  "frameworks": {
    "arduino": {
      "package": "framework-arduinoespressif32",
      "script": "builder/frameworks/arduino.py"
    },
    "espidf": {
      "package": "framework-espidf",
      "script": "builder/frameworks/espidf.py"
    }
  },
  "packages": {
    "toolchain-riscv32-esp": {
      "type": "toolchain",
      "owner": "platformio",
      "version": "~8.4.0"
    },
    "framework-arduinoespressif32": {
      "type": "framework",
      "optional": true,
      "owner": "platformio",
      "version": "~3.20000.0"
    },
    "framework-espidf": {
      "type": "framework",
      "optional": true,
      "owner": "platformio",
      "version": "~3.50000.0"
    },
    "tool-esptoolpy": {
      "type": "uploader",
      "owner": "platformio",
      "version": "~1.40500.0"
    }
  }
}
